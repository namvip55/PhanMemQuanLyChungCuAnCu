<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <add name="QuanLyChungCuAnCu"
         connectionString="Data Source=.\MSSQLSERVER01;Initial Catalog=QuanLyChungCuAnCu;Integrated Security=True;TrustServerCertificate=True;Encrypt=False;"
         providerName="Microsoft.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <add key="AppName" value="Quản lý Chung cư An Cư" />
    <add key="Version" value="1.0.0" />
  </appSettings>
</configuration>
